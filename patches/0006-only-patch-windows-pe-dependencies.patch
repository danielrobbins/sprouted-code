+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import assert from 'assert';
+import * as fs from 'fs';
+import * as os from 'os';
+import * as path from 'path';
+import { after, suite, test } from 'node:test';
+import { isWindowsPortableExecutable } from '../win32.ts';
+
+suite('win32', () => {
+	const testDirectory = fs.mkdtempSync(path.join(os.tmpdir(), 'vscode-win32-test-'));
+	after(() => fs.rmSync(testDirectory, { recursive: true, force: true }));
+
+	async function writeFixture(name: string, contents: Buffer): Promise<string> {
+		const filePath = path.join(testDirectory, name);
+		await fs.promises.writeFile(filePath, contents);
+		return filePath;
+	}
+
+	test('recognizes a PE binary', async () => {
+		const contents = Buffer.alloc(0x84);
+		contents.write('MZ');
+		contents.writeUInt32LE(0x80, 0x3c);
+		contents.set([0x50, 0x45, 0x00, 0x00], 0x80);
+
+		assert.strictEqual(await isWindowsPortableExecutable(await writeFixture('native.node', contents)), true);
+	});
+
+	test('rejects non-PE and malformed binaries', async () => {
+		const elf = Buffer.from([0x7f, 0x45, 0x4c, 0x46]);
+		const truncated = Buffer.from('MZ');
+		const invalidSignature = Buffer.alloc(0x84);
+		invalidSignature.write('MZ');
+		invalidSignature.writeUInt32LE(0x80, 0x3c);
+		invalidSignature.write('NOPE', 0x80);
+
+		assert.strictEqual(await isWindowsPortableExecutable(await writeFixture('linux.node', elf)), false);
+		assert.strictEqual(await isWindowsPortableExecutable(await writeFixture('truncated.node', truncated)), false);
+		assert.strictEqual(await isWindowsPortableExecutable(await writeFixture('invalid.node', invalidSignature)), false);
+	});
+});
