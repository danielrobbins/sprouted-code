+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import * as fs from 'fs';
+
+const DOS_HEADER_SIZE = 64;
+const PE_HEADER_OFFSET = 0x3c;
+const PE_SIGNATURE_SIZE = 4;
+
+export async function isWindowsPortableExecutable(filePath: string): Promise<boolean> {
+	const file = await fs.promises.open(filePath, 'r');
+	try {
+		const dosHeader = Buffer.alloc(DOS_HEADER_SIZE);
+		const dosRead = await file.read(dosHeader, 0, dosHeader.length, 0);
+		if (dosRead.bytesRead !== dosHeader.length || dosHeader.toString('ascii', 0, 2) !== 'MZ') {
+			return false;
+		}
+
+		const peHeaderOffset = dosHeader.readUInt32LE(PE_HEADER_OFFSET);
+		const peSignature = Buffer.alloc(PE_SIGNATURE_SIZE);
+		const peRead = await file.read(peSignature, 0, peSignature.length, peHeaderOffset);
+		return peRead.bytesRead === peSignature.length
+			&& peSignature.equals(Buffer.from([0x50, 0x45, 0x00, 0x00]));
+	} finally {
+		await file.close();
+	}
+}
